# ════════════════════════════════════════════════════
# Moonson — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════

# ── Bot Identity ──
# Your WhatsApp number with country code, no + or spaces
BOT_NUMBER=233533416608

# ── Owner ──
# Your WhatsApp number (usually same as BOT_NUMBER)
OWNER_NUMBER=233533416608

# ── Links (change per deployment) ──
# WhatsApp group invite link
GROUP_LINK=https://chat.whatsapp.com/Hd5ypF26Wr9ETljOqJGHAS
# WhatsApp channel link
CHANNEL_LINK=https://whatsapp.com/channel/0029Vb7eSHf42Dcmdd3XA326

# ── Newsletter / Annotations ──
NEWSLETTER_ID=120363406397452589@newsletter
NEWSLETTER_NAME="Moonson"

# ── Pterodactyl (optional — only if you sell servers) ──
PTERO_PANEL_URL=https://panel.username.org
PTERO_API_KEY=ptla_xxxxx

# ── Port (Railway/Heroku auto-inject this) ──
# PORT=3000
